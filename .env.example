###############################################################################
# Application
###############################################################################
APP_NAME="Conseiller Numérique"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Europe/Paris

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

###############################################################################
# Journalisation (canaux dédiés : securite, auth, mails, rdv, ateliers, admin, rgpd)
###############################################################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=30

###############################################################################
# Base de données — MySQL 8+ / MariaDB 10.11+
###############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=conseillernumerique
DB_USERNAME=root
DB_PASSWORD=

###############################################################################
# Sessions / cache / files d'attente
###############################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Passer à true derrière HTTPS (obligatoire en production)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

###############################################################################
# Emails
###############################################################################
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Adresse recevant les notifications d'administration (demandes, inscriptions…)
ADMIN_NOTIFICATION_EMAIL="contact@example.test"
# Adresse dédiée aux demandes RGPD (droit d'accès, effacement…)
RGPD_CONTACT_EMAIL="rgpd@example.test"

###############################################################################
# Stockage compatible S3 (facultatif)
###############################################################################
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-3
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

###############################################################################
# Sécurité
###############################################################################
# Content-Security-Policy : activer en production
SECURITY_CSP_ENABLED=true
# Forcer HTTPS (à activer en production uniquement)
SECURITY_FORCE_HTTPS=false
# Limitation des formulaires publics : nombre d'envois par heure et par IP
SECURITY_FORM_RATE_LIMIT=5
# Limitation des tentatives de connexion admin
SECURITY_LOGIN_MAX_ATTEMPTS=5
SECURITY_LOGIN_DECAY_MINUTES=15

###############################################################################
# RGPD — durées de conservation en jours
###############################################################################
RGPD_RETENTION_APPOINTMENTS=1095
RGPD_RETENTION_REGISTRATIONS=1095
RGPD_RETENTION_CONTACTS=365
RGPD_RETENTION_PARTNERSHIPS=1095
RGPD_RETENTION_CONSENT_LOGS=2190
RGPD_RETENTION_AUDIT_LOGS=1095

###############################################################################
# Mesure d'audience respectueuse de la vie privée (Matomo sans cookies)
###############################################################################
ANALYTICS_ENABLED=false
ANALYTICS_MATOMO_URL=
ANALYTICS_MATOMO_SITE_ID=

###############################################################################
# Vite
###############################################################################
VITE_APP_NAME="${APP_NAME}"
