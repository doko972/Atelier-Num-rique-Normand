# -----------------------------------------------------------------------------
# Données personnelles et fichiers d'exploitation (codex §39)
#
# Rien de ce qui suit ne doit jamais rejoindre le dépôt : documents transmis
# par les usagers, exports, sauvegardes, journaux.
# -----------------------------------------------------------------------------
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/logs/*
!/storage/logs/.gitignore

*.sql
*.sql.gz
*.sql.gz.gpg
/sauvegardes/
/exports/
*.csv
!/tests/**/*.csv
